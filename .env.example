# Docker local: 8080 web, 3001 API. Giữ trống FIREBASE_PROJECT_ID để chơi khách.
PORT=3001
FIREBASE_PROJECT_ID=
REQUIRE_VERIFIED_EMAIL=true
ALLOW_GUEST=true
GUEST_SECRET=replace-with-a-random-string-at-least-32-characters
# Thêm IP LAN máy bạn nếu chơi từ điện thoại, vd http://192.168.1.10:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost,https://localhost,capacitor://localhost
# Mặc định web cùng origin dùng proxy /api và /socket.io
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
